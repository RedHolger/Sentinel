            "reason_codes": [
              "SENSOR_SATURATION_POSSIBLE"
            ]
          }
        ]
      }
    },
    {
      "case_id": "case_05_mixed_windows",
      "description": "Multi-window recording containing NORMAL (w0), saturated abstention (w1), and ANOMALY (w2)",
