      "metadata_path": "metadata_1000hz.json",
      "config_path": "config_1000hz_fs10_th2.json",
      "expected_csv_sha256": "9c8049b9b1cdef70cd87c1db8b6623ba8584de307a081f604e48e4a6a61a101f",
      "expected_result": {
        "scope": "window",
        "windows": [
          {
            "window_index": 0,
            "start_sample": 0,
            "end_sample": 5,
            "outcome": "ANOMALY",
            "quality_status": "PASS",
            "reason_codes": []
          }
        ]
      }
    },
    {
      "case_id": "case_03_threshold_equality",
      "description": "Single-channel window with RMS exactly equal to threshold (RMS=2.0 == 2.0 -> ANOMALY)",
      "csv_path": "equality_5samples.csv",
      "metadata_path": "metadata_1000hz.json",
      "config_path": "config_1000hz_fs10_th2.json",
      "expected_csv_sha256": "f49f44d30f336d3e85f21d1cf342d00bc500e744acec86e099597ff9b7189618",
      "expected_result": {
        "scope": "window",
        "windows": [
          {
            "window_index": 0,
            "start_sample": 0,
            "end_sample": 5,
            "outcome": "ANOMALY",
            "quality_status": "PASS",
            "reason_codes": []
          }
        ]
      }
    },
    {
      "case_id": "case_04_sensor_saturation",
      "description": "Single-channel window containing sample 12.0 >= full_scale 10.0 -> INSUFFICIENT_EVIDENCE",
      "csv_path": "saturation_5samples.csv",
      "metadata_path": "metadata_1000hz.json",
      "config_path": "config_1000hz_fs10_th2.json",
