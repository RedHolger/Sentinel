      "config_path": "config_1000hz_fs10_th2.json",
      "expected_csv_sha256": "f136415649a2d511037c028ca5eb57bde4cc9257c94e2c87247dcab92b140e6c",
      "expected_result": {
        "scope": "window",
        "windows": [
          {
            "window_index": 0,
            "start_sample": 0,
            "end_sample": 5,
            "outcome": "NORMAL",
            "quality_status": "PASS",
            "reason_codes": []
          }
        ]
      }
    },
    {
      "case_id": "case_02_anomaly_window",
      "description": "Single-channel anomaly window strictly above threshold (RMS=3.0 >= 2.0)",
